# 59 — Full Pipeline: Genotype × Drug Disease → Realistic Simulation
#
# Scenario: 42F, 68 kg, 165 cm, autoimmune vasculitis
#   Genotype: CYP2D6 *4/*4 (poor metabolizer), SLCO1B1 *5/*5 (reduced function)
#   Drug: Vasclexib (novel JAK/IRAK4 dual inhibitor, built from SMILES)
#   Disease: systemic autoimmune vasculitis (category: autoimmune)
#
# This example demonstrates the FULL helix DSL pipeline:
#   1. Pharmacogene annotations → CYP/transporter activity scores
#   2. SMILES-only drug → ADME inferred (MW, Vd, CL, t½, F)
#   3. Target protein → PD auto-inferred (JAK inhibition)
#   4. CYP/transporter metabolism fractions → genotype-modified PK
#   5. Treatment (21d) + recovery (28d) = 49 days total
#
# Usage:
#   helixlang examples/59_full_pipeline_genotype_drug_disease.helix --json
#   python examples/59_full_pipeline_genotype_drug_disease.py

# ─── PATIENT ──────────────────────────────────────────────────────────────
# 42-year-old female, East Asian, autoimmune vasculitis

#person name=Li_Wei age=42 sex=female weight=68 height=165 ethnicity=east_asian

# ─── PHARMACOGENES ───────────────────────────────────────────────────────
# CYP2D6 *4/*4 → poor metabolizer (activity score 0.0 → CL reduced)
# CYP3A4 *1/*1 → normal metabolizer
# CYP2C19 *1/*1 → normal metabolizer
# SLCO1B1 *5/*5 → reduced hepatic uptake (activity score 1.0 → higher Cmax)
# ABCB1 *1/*1 → normal P-glycoprotein function

#gene name=CYP2D6 allele=*4 zygosity=hom_alt
#gene name=CYP3A4 allele=*1 zygosity=hom_ref
#gene name=CYP2C19 allele=*1 zygosity=hom_ref
#gene name=SLCO1B1 allele=*5 zygosity=hom_alt
#gene name=ABCB1 allele=*1 zygosity=hom_ref

# ─── LIFESTYLE ───────────────────────────────────────────────────────────

#trait smoking=never pack_years=0 alcohol=0 exercise=moderate

# ─── DISEASE: AUTOIMMUNE VASCULITIS ──────────────────────────────────────
# Novel autoimmune vasculitis with multi-organ involvement
# Category autoimmune triggers autoimmune RAODE (inflammation-driven)

#disease name="systemic autoimmune vasculitis" category=autoimmune severity=0.6 onset_age=35

# ─── DRUG: VASCLEXIB (novel JAK/IRAK4 dual inhibitor) ────────────────────
# SMILES only — MW, formula, LogP, ADME all inferred by RDKit
#   MW = 493.0 Da, LogP ~3.2
#   Bioavailability ~0.65, Vd ~120 L, CL ~63 mL/min, t½ ~22h
# Target: JAK → PD auto-inferred (JAK inhibition, EC50 from binding affinity)
# CYP metabolism: 55% CYP3A4, 30% CYP2D6, 15% CYP2C19
#   → CYP2D6 PM will reduce total clearance by ~30%
# Transporter: 60% SLCO1B1, 15% ABCB1
#   → SLCO1B1 *5/*5 reduces hepatic uptake, higher systemic exposure

#drug name=vasclexib smiles=CC(=O)Nc1ccc(C(=O)Nc2ccc(CN3CCN(c4ccc(Cl)cc4)CC3)cc2)cc1 mw=493.0 target_protein=JAK binding_affinity_kd=0.05 dose=250 route=oral interval=24 duration=21 bioavailability=0.65 vd=120.0 cl=63.0 half_life=22.0 cyp_metabolism=CYP3A4:0.55,CYP2D6:0.30,CYP2C19:0.15 transporter_affected=SLCO1B1:0.6,ABCB1:0.15

# ─── SIMULATION ──────────────────────────────────────────────────────────
# 49 days total: 21 days treatment + 28 days recovery
# Hourly time step, 6-hour output resolution

#sim kind=human duration_days=49 dfa_dt_h=1.0 output_resolution_h=6.0

# ─── EXPECTED OUTPUT ─────────────────────────────────────────────────────
#
# GENOTYPE EFFECT:
#   CYP2D6 *4/*4 (PM): ~30% of metabolism via CYP2D6 is reduced
#   → Total clearance reduced → Cmax elevated 10-20% vs normal metabolizer
#   SLCO1B1 *5/*5: hepatic OATP1B1 reduced function
#   → Higher systemic drug levels (less hepatic first-pass extraction)
#
# Day 0 (baseline):
#   Autoimmune vasculitis active: CRP ~25 mg/L, mild joint inflammation
#   BP ~125/80, HR ~78, Temp ~36.8C, WBC ~8000
#   ALT ~28 U/L, Cr ~0.9 mg/dL, eGFR ~95 mL/min
#
# Day 1-7 (early treatment):
#   Vasclexib achieves steady state (Cmax ~4.5 µM, trough ~2.0 µM)
#   JAK inhibition reduces inflammatory signaling
#   CRP declining: 25 → 12 mg/L
#   Mild ALT elevation possible (drug metabolism stress)
#
# Day 14 (mid-treatment):
#   CRP ~6 mg/L (near normal)
#   Disease severity declining: 0.6 → 0.35
#   ALT ~35 U/L (mild, monitored)
#
# Day 21 (end of treatment):
#   CRP ~3 mg/L (normal)
#   Disease severity ~0.25 (controlled)
#   Drug begins washout
#
# Day 21-49 (recovery):
#   Drug washout: 4.5 → 0 µM over ~5 half-lives (5 × 22h ≈ 4.6 days)
#   CRP stable ~2-3 mg/L
#   Disease severity stabilizes or slowly rebounds
#   ALT normalizes: 35 → 28 U/L
#   No toxicity events expected (SMILES-based: low hepatotoxicity)
#
# KEY SAFETY:
#   - LFTs q48h: vasclexib hepatotoxicity monitoring
#   - CRP weekly: treatment response
#   - CBC weekly: myelosuppression (JAK inhibitors can cause cytopenias)
