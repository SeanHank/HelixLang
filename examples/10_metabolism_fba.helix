# Example 10: Metabolism - flux balance analysis (FBA)
# Shows cell growth on glucose
#
# HelixLang's #gene / #promoter annotations describe the regulatory context of metabolic enzymes,
# while the actual FBA (Flux Balance Analysis) is run via the Python API:
#   from helixlang.metabolism import FluxBalanceAnalysis
#   fba = FluxBalanceAnalysis(ECOLI_CORE_MODEL)
#   fba.set_uptake("GLC", 10.0)
#   fba.solve()
#
# Gene -> reaction mapping (glycolysis pathway):
#   glk  : glucokinase                    glucose -> G6P
#   pgi  : glucose-6-phosphate isomerase  G6P -> F6P
#   pyk  : pyruvate kinase                PEP -> pyruvate
#   biomass : biomass synthesis reaction

#promoter name=p_glc strength=-0.3

#gene name=glk promoter=p_glc
ATG GCT GCT GCT GCT TAA
#end

#gene name=pgi promoter=p_glc
ATG GGT GGT GGT GGT TAA
#end

#gene name=pyk promoter=p_glc
ATG GCT GGT GCT GGT TAA
#end

#regulate p_glc -> glk strength=+0.8
#regulate p_glc -> pgi strength=+0.7
#regulate p_glc -> pyk strength=+0.6

