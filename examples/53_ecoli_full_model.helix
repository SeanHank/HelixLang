// Example 53: E. coli iML1515 Full Genome-Scale Model
// doc/24 Phase F — demonstrates using a full 2712-reaction GEM
// instead of the 42-reaction core model.
//
// This example loads the complete iML1515 model from BiGG,
// applies glucose_minimal medium, and runs FBA to get the
// optimal growth rate (~0.87 h⁻¹ on original bounds, ~0.82 with
// O₂ capped at 20 mmol/gDW/h).
//
// Requirements: pip install cobra (or pip install helixlang[bio])

#organism e_coli_k12 {
    genome "E. coli K-12 MG1655"
    type prokaryote
    metabolic_model "iML1515"
}

#cell ecoli_pop {
    organism e_coli_k12
    count 1000

    #media {
        glucose 10.0 mM
        o2 20.0 mM
        nh4 1000.0 mM
        pi 1000.0 mM
    }

    #gem {
        use_full_model true
    }

    #growth {
        method fba
        objective biomass
    }
}

#environment env {
    patches 1
    spatial false

    #timeline {
        duration 10 h
        dt 0.05 h
        output every 1 h
    }
}

#run {
    environment env
    cells ecoli_pop
    log "ecoli_full_model.log"
}
