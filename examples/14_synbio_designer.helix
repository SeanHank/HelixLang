# Example 14: Synthetic biology designer - gene cassette design
# Designs a standardized expression cassette: promoter -> RBS -> GOI -> terminator
#
# Structure diagram:
#   [Promoter] -- [RBS] -- [GOI: target_protein] -- [Terminator]
#        |                       |
#    regulatory input (inducer)        expression output protein
#
# This .helix file provides the DNA context of the cassette's GOI (gene of interest);
# the cassette auto-design (promoter/RBS/terminator selection, codon optimization,
# restriction-site avoidance, GC targeting, validation) runs through the #sim
# extension point (kind=synbio_design) using helixlang.apps.synbio_designer.

#promoter name=p_inducible strength=0.6

# Gene of interest GOI (coding region of the target protein)
#gene name=goi_target promoter=p_inducible
ATG GCT GCT GGT GCT GGT GCT TAA
#end

#regulate p_inducible -> goi_target strength=+0.9

#config backend=fba ticks=1
#sim kind=synbio_design promoter=lac rbs=aggagg terminator=rrnB_T1
#sim optimize_codons=true avoid_restriction=true gc_target=0.5
