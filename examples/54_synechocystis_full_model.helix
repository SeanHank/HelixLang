#enzyme gene=psaA reaction=PSI kcat=45
#enzyme gene=psbA reaction=PSII kcat=30
#enzyme gene=cbbM reaction=CBBCM kcat=3.3 km=0.02
#enzyme gene=zwf reaction=G6PDH2r kcat=270

#reaction id=PSII name=Photosystem_II substrate=h2o product=o2 lower_bound=0 upper_bound=1000 subsystem=photosynthesis
#reaction id=PSI name=Photosystem_I substrate=plastocyanin_ox product=plastocyanin_red lower_bound=0 upper_bound=1000 subsystem=photosynthesis
#reaction id=CBBCM name=RuBisCO_carboxylation substrate=co2 product=3pg lower_bound=0 upper_bound=1000 subsystem=calvin_cycle

#species name=synecho use_full_model=true substrate=co2 photo=true photo_vmax=0.292 ks=0.5 cn_ratio=6.0 maintenance=0.0002

#patch name=freshwater kind=chemostat width=3 height=3 temperature=25.0 ph=7.5 flow_rate=0.0 initial_nh4_mm=0.0 initial_no3_mm=15.4
#patch name=freshwater initial.synecho=0.05
#patch name=freshwater substrate.co2.initial=10.0 substrate.co2.bulk=10.0 substrate.co2.carbon_per_mol=1
#patch name=freshwater substrate.oxygen.initial=0.25 substrate.oxygen.bulk=0.25 substrate.oxygen.carbon_per_mol=0
#patch name=freshwater substrate.no3.initial=15.4 substrate.no3.bulk=15.4 substrate.no3.carbon_per_mol=0
#patch name=freshwater substrate.nh4.initial=0.0 substrate.nh4.bulk=0.0 substrate.nh4.carbon_per_mol=0
#patch name=freshwater substrate.fe3.initial=0.012 substrate.fe3.bulk=0.012 substrate.fe3.carbon_per_mol=0
#patch name=freshwater scalar.light.initial=200.0 scalar.light.amplitude=200.0 scalar.light.forcing=diurnal

#config backend=ecosystem ticks=480 gem_driven=true

#sim output=tick,freshwater:synecho,freshwater:co2,freshwater:oxygen,freshwater:no3,freshwater:light
