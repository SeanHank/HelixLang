.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Type checkers / linters cache
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.dmypy.json
dmypy.json

# pytest cache
.pytest_cache/
.cache/

# pytest-benchmark storage
.benchmarks/

# Environments
.venv/
venv/
env/
ENV/
.python-version

